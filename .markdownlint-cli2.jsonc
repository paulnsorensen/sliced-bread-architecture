{
  "config": {
    // Prettier owns wrapping and style; markdownlint owns structure.
    "MD013": false, // line length — prose wrap is preserved
    "MD033": false, // inline HTML — needed for site content
    "MD041": false, // first line need not be a top-level heading (frontmatter)
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "site/node_modules", "site/dist", ".cheese"],
}
